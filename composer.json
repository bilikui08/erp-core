{
    "name": "gustavoluis/erp-core",
    "description": "Piezas comunes de los servicios del ERP: autenticación por JWT de auth-api, empresas, autoría y auditoría.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "GustavoLuis\\ErpCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GustavoLuis\\ErpCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GustavoLuis\\ErpCore\\ErpCoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
